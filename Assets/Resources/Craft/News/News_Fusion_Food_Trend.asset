  sectionTag: "\uD4E8\uC804"
  headline: "\uD4E8\uC804 \uC6CC\uD06C\uC20D \uC5F4\uD48D, '\uB450 \uBB38\uD654\uC758
    \uBC25' \uC778\uAE30"
  subheadline: "\uB450 \uBB38\uD654 \uC774\uC0C1\uC758 \uC7AC\uB8CC\uB97C \uC870\uD569\uD55C
    \uD4E8\uC804 \uBA54\uB274\uAC00 \uC678\uC2DD \uD2B8\uB80C\uB4DC\uB85C \uB5A0\uC624\uB974\uACE0
    \uC788\uC2B5\uB2C8\uB2E4."
  body: "\uB450 \uBB38\uD654 \uC774\uC0C1\uC758 \uC7AC\uB8CC\uB97C \uC870\uD569\uD55C
    \uD4E8\uC804 \uBA54\uB274\uAC00 \uC678\uC2DD \uD2B8\uB80C\uB4DC\uB85C \uB5A0\uC624\uB974\uACE0
    \uC788\uC2B5\uB2C8\uB2E4."
  article: "\uB300\uD559\xB7\uC9C0\uC5ED\uC13C\uD130\uC5D0\uC11C \uC5F4\uB9B0 '\uD4E8\uC804
    \uC6CC\uD06C\uC20D'\uC5D0 \uC2DC\uBBFC \uCC38\uC5EC\uAC00 \uD3ED\uBC1C\uC801\uC73C\uB85C
    \uB298\uC5C8\uC2B5\uB2C8\uB2E4. \uD560\uB784\xB7\uBE44\uAC74\xB7\uD55C\uC2DD
    \uC7AC\uB8CC\uB97C \uC11E\uC740 \uC2E4\uD5D8 \uBA54\uB274\uAC00 \uC18C\uAC1C\uB410\uACE0,
    \uCC38\uAC00\uC790\uB4E4\uC740 \"\uCC28\uC774\uB97C \uC11E\uB294 \uAC83\uC774
    \uD3B8\uACAC\uC744 \uC904\uC778\uB2E4\"\uACE0 \uB9D0\uD588\uC2B5\uB2C8\uB2E4.\n\n\uC77C\uBD80
    \uC2DD\uB2F9\uC740 \uC6CC\uD06C\uC20D \uC774\uD6C4 \uD55C\uC815 \uBA54\uB274\uB97C
    \uC601\uC5C5\uC5D0 \uB3C4\uC785\uD558\uAE30\uB3C4 \uD588\uC2B5\uB2C8\uB2E4."
  sidebarNote: "\uC735\uD569\uC740 \uBB38\uD654 \uC0C1\uB300\uC8FC\uC758\uC758 \uB9DB\uC788\uB294
    \uC2E4\uC2B5\uC785\uB2C8\uB2E4."
  summary: "\uD4E8\uC804 \uC6CC\uD06C\uC20D \uC774\uBCA4\uD2B8 \uC2DC M20~M23 \uBA54\uB274\uB97C
    \uD65C\uC6A9\uD558\uC138\uC694."
  illustration: {fileID: 0}
  primaryStockCode: UNITY
