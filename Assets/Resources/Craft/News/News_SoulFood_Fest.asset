  sectionTag: "\uBB38\uD654"
  headline: "\uC18C\uC6B8\uD478\uB4DC \uD398\uC2A4\uD2F0\uBC8C, \uC0C1\uC0DD \uC0C1\uAD8C '\uD65C\uAE30'"
  subheadline: "\uD751\uC778 \uB514\uC544\uC2A4\uD3EC\uB77C \uC2DD\uBB38\uD654\uB97C \uC870\uBA85\uD558\uB294 \uCD95\uC81C\uAC00 \uB3C4\uC2EC\uC744 \uB2EC\uAD9C\uC2B5\uB2C8\uB2E4."
  body: "\uD751\uC778 \uB514\uC544\uC2A4\uD3EC\uB77C \uC2DD\uBB38\uD654\uB97C \uC870\uBA85\uD558\uB294 \uCD95\uC81C\uAC00 \uB3C4\uC2EC\uC744 \uB2EC\uAD9C\uC2B5\uB2C8\uB2E4."
  article: "\uC2DC\uB0B4 \uAD11\uC7A5\uC5D0\uC11C \uC5F4\uB9B0 \uC18C\uC6B8\uD478\uB4DC \uD398\uC2A4\uD2F0\uBC8C\uC5D0 \uC2DC\uBBFC\uACFC \uAD00\uAD11\uAC1D\uC774 \uBAB0\uB838\uC2B5\uB2C8\uB2E4. \uD504\uB77C\uC774\uB4DC \uCE58\uD0A8\u00B7\uAC80\uBCF4\u00B7\uCF5C\uB77C\uB3C4 \uADF8\uB9B0\uC2A4 \uB4F1 \uBA54\uB274\uAC00 \uC18C\uAC1C\uB410\uACE0, \uCC38\uAC00\uC790\uB4E4\uC740 \uC74C\uC2DD\uACFC \uC74C\uC545\u00B7\uC5ED\uC0AC\uB97C \uD568\uAED8 \uACBD\uD5D8\uD588\uC2B5\uB2C8\uB2E4.\n\n\uC8FC\uCD5C \uCE21\uC740 \"\uB9DB\uC73C\uB85C \uB9CC\uB098\uB294 \uC5F0\uB300\"\uB97C \uB0B4\uC138\uC6E0\uC73C\uBA70, \uC778\uADFC \uC0C1\uAD8C\uB3C4 \uBC29\uBB38\uAC1D \uC99D\uAC00\uB85C \uD65C\uAE30\uB97C \uB760\uC5C8\uC2B5\uB2C8\uB2E4. \uB2E4\uBB38\uD654 \uC0C1\uC0DD \uC9C0\uC218\uC5D0\uB3C4 \uAE0D\uC815\uC801 \uC2E0\uD638\uAC00 \uAD00\uCE21\uB429\uB2C8\uB2E4."
  sidebarNote: "\uCD95\uC81C\uB294 \uCC28\uC774\uB97C \uBB34\uB300\uB85C, \uACF5\uC874\uC744 \uC77C\uC0C1\uC73C\uB85C \uB9CC\uB4ED\uB2C8\uB2E4."
  summary: "\uB2E4\uC591\uD55C \uBB38\uD654\uAD8C \uC190\uB2D8\uC774 \uB298 \uC218 \uC788\uC2B5\uB2C8\uB2E4. \uB530\uB73B\uD558\uACE0 \uC815\uD655\uD55C \uC751\uB300\uAC00 \uD3C9\uD310\uC744 \uB9CC\uB4ED\uB2C8\uB2E4."
  illustration: {fileID: 21300000, guid: a86821c0199e418a815a218192dd85cd, type: 3}
  primaryStockCode: UNITY
