  sectionTag: "\uC18C\uBE44"
  headline: "\uBE44\uAC74 \uB77C\uBCA8 \uACFC\uC7A5 \uAD11\uACE0 \uB17C\uB780 \uD655\uC0B0"
  subheadline: "\uB3D9\uBB3C\uC131 \uC6D0\uB8CC\uAC00 \uAC80\uCD9C\uB41C '\uBE44\uAC74'
    \uC81C\uD488 \uC0AC\uB840\uAC00 \uC787\uB530\uB974\uACE0 \uC788\uC2B5\uB2C8\uB2E4."
  body: "\uB3D9\uBB3C\uC131 \uC6D0\uB8CC\uAC00 \uAC80\uCD9C\uB41C '\uBE44\uAC74'
    \uC81C\uD488 \uC0AC\uB840\uAC00 \uC787\uB530\uB974\uACE0 \uC788\uC2B5\uB2C8\uB2E4."
  article: "\uC2DC\uC911 \uC77C\uBD80 '\uBE44\uAC74' \uD45C\uAE30 \uC81C\uD488\uC5D0\uC11C
    \uB3D9\uBB3C\uC131 \uC131\uBD84\uC774 \uAC80\uCD9C\uB410\uB2E4\uB294 \uC870\uC0AC
    \uACB0\uACFC\uAC00 \uBC1C\uD45C\uB418\uBA70 \uC18C\uBE44\uC790 \uBD88\uC2E0\uC774
    \uCEE4\uC9C0\uACE0 \uC788\uC2B5\uB2C8\uB2E4. SNS\uC5D0\uC11C\uB294 \uADF8\uB9B0\uC6CC\uC2F1
    \uBE44\uD310\uC774 \uC774\uC5B4\uC84C\uACE0, \uBE44\uAC74 \uC2DD\uB2F9\uB3C4
    \uAD50\uCC28\uC624\uC5FC\xB7\uC131\uBD84 \uD45C\uAE30\uB97C \uC7AC\uC810\uAC80\uD558\uACE0
    \uC788\uC2B5\uB2C8\uB2E4.\n\n\uC5C5\uACC4 \uAD00\uACC4\uC790\uB294 \"\uB77C\uBCA8\uBCF4\uB2E4
    \uC870\uB9AC \uACFC\uC815 \uD22C\uBA85\uC131\uC774 \uC911\uC694\uD558\uB2E4\"\uACE0
    \uB9D0\uD588\uC2B5\uB2C8\uB2E4. \uC644\uC804 \uCC44\uC2DD\uC744 \uC9C0\uD0A4\uB294
    \uC190\uB2D8\uC77C\uC218\uB85D \uC131\uBD84 \uD655\uC778\uC744 \uB354 \uAE4C\uB2E4\uB86D\uAC8C
    \uC694\uAD6C\uD560 \uC804\uB9DD\uC785\uB2C8\uB2E4."
  sidebarNote: "\uC2E0\uB150\uC744 \uC874\uC911\uD558\uB294 \uC2DD\uC0AC\uB294 \uD45C\uC2DC\uBCF4\uB2E4
    \uC2E4\uCC9C\uC5D0\uC11C \uB4DC\uB7EC\uB0A9\uB2C8\uB2E4."
  summary: "\uBE44\uAC74 \uC190\uB2D8\uC774 \uC2E0\uC911\uD574\uC9C8 \uC218 \uC788\uC2B5\uB2C8\uB2E4.
    \uACC4\uB780\xB7\uC720\uC81C\uD488\xB7\uC721\uB958 \uAD50\uCC28\uC624\uC5FC\uC744
    \uCCA0\uC800\uD788 \uD655\uC778\uD558\uC138\uC694."
  illustration: {fileID: 21300000, guid: 1cfc959e1fa6433c83aa1214e1ed1c67, type: 3}
  primaryStockCode: VGND
