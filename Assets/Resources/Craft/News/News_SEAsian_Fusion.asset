  sectionTag: "\uBB38\uD654"
  headline: "\uB3D9\uB0A8\uC544 \uC774\uC8FC\uBBFC \uCEE4\uBBA4\uB2C8\uD2F0, '\uACE0\uD5A5\uC758
    \uB9DB' \uACF5\uC720 \uD589\uC0AC"
  subheadline: "\uC800\uB834\uD558\uACE0 \uB4E0\uB4E0\uD55C \uD55C \uB07C\uC5D0 \uB300\uD55C
    \uAD00\uC2EC\uC774 \uC774\uC8FC\uBBFC\xB7\uD604\uC9C0\uC778 \uBAA8\uB450\uC5D0\uAC8C
    \uCEE4\uC9C0\uACE0 \uC788\uC2B5\uB2C8\uB2E4."
  body: "\uC800\uB834\uD558\uACE0 \uB4E0\uB4E0\uD55C \uD55C \uB07C\uC5D0 \uB300\uD55C
    \uAD00\uC2EC\uC774 \uC774\uC8FC\uBBFC\xB7\uD604\uC9C0\uC778 \uBAA8\uB450\uC5D0\uAC8C
    \uCEE4\uC9C0\uACE0 \uC788\uC2B5\uB2C8\uB2E4."
  article: "\uB3D9\uB0A8\uC544 \uCD9C\uC2E0 \uB178\uB3D9\uC790\uC640 \uD559\uC0DD\uB4E4\uC774
    \uBAA8\uC778 \uC9C0\uC5ED\uC5D0\uC11C '\uACE0\uD5A5 \uBC25\uC0C1' \uB098\uB214
    \uD589\uC0AC\uAC00 \uC5F4\uB838\uC2B5\uB2C8\uB2E4. \uD5A5\uC2E0\uB8CC\uC640 \uD574\uC0B0\uBB3C,
    \uC300 \uC704\uC8FC\uC758 \uBA54\uB274\uAC00 \uC18C\uAC1C\uB410\uC73C\uBA70,
    \uCC38\uAC00\uC790\uB4E4\uC740 \"\uB9DB\uC774 \uACE7 \uAE30\uC5B5\uC774\uC790
    \uC815\uCCB4\uC131\"\uC774\uB77C\uACE0 \uB9D0\uD588\uC2B5\uB2C8\uB2E4.\n\n\uC77C\uBD80
    \uC0C1\uC778\uC740 \uB3D9\uB0A8\uC544 \uC190\uB2D8\uC774 \uB9CE\uC740 \uC2DC\uAC04\uB300\uC5D0
    \uB9DE\uCDB0 \uBA54\uB274\uB97C \uC870\uC815\uD558\uACE0, \uAC00\uACA9\uB300\uB97C
    \uB0AE\uCD98 \uC138\uD2B8\uB97C \uC900\uBE44\uD558\uAE30\uB3C4 \uD569\uB2C8\uB2E4."
  sidebarNote: "\uC774\uC8FC\uBBFC\uC758 \uC2DD\uBB38\uD654\uB294 \uC6B0\uB9AC \uB3D9\uB124
    \uACBD\uC81C\uC640\uB3C4 \uC5F0\uACB0\uB429\uB2C8\uB2E4."
  summary: "\uB2F4\uBC31\xB7\uC800\uAC00 \uBA54\uB274 \uC218\uC694\uAC00 \uB298 \uC218
    \uC788\uC2B5\uB2C8\uB2E4. \uD574\uC0B0\uBB3C \uC54C\uB808\uB974\uAE30\uB3C4 \uD568\uAED8
    \uD655\uC778\uD558\uC138\uC694."
  illustration: {fileID: 21300000, guid: f7b0bd8fc3cf4b1a8d4bf54b322b20c9, type: 3}
  primaryStockCode: SEAFO
