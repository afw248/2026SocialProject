  headline: "\uD560\uB784 \uD478\uB4DC \uC5F4\uD48D"
  body: "\uBB34\uC2AC\uB9BC \uCE5C\uD654 \uBA54\uB274 \uC218\uC694\uAC00 \uD06C\uAC8C
    \uB298\uC5C8\uC2B5\uB2C8\uB2E4."
  article: "\uB3C4\uC2EC \uACF3\uACF3\uC5D0\uC11C \uD560\uB784 \uC778\uC99D \uC2DD\uB2F9\uC774 \uC904\uC744
    \uC11C\uACE0 \uC788\uC2B5\uB2C8\uB2E4. \uBB34\uC2AC\uB9BC \uCEE4\uBBA4\uB2C8\uD2F0\uB294 \uB3C5\uC2DC\uC790\uB97C
    \uAC00\uC7A5 \uC911\uC694\uD558\uAC8C \uC5EC\uAE30\uBA70, \uD560\uB784 \uBA54\uB274 \uC218\uC694\uAC00 \uD3C9\uC18C\uBCF4\uB2E4
    \uB192\uC2B5\uB2C8\uB2E4."
  summary: "\uC624\uB298\uC740 \uBB34\uC2AC\uB9BC \uC190\uB2D8 \uBC29\uBB38\uC774 \uB298 \uC218 \uC788\uC2B5\uB2C8\uB2E4.
    \uD560\uB784 \uBA54\uB274\uB97C \uC900\uBE44\uD558\uBA74 \uD638\uC751\uC774 \uC88B\uC744 \uAC83\uC785\uB2C8\uB2E4."
