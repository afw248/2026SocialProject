  sectionTag: "\uB77C\uC774\uD504"
  headline: "\uBE44\uAC74 \uC778\uAD6C \uC99D\uAC00, '\uC644\uC804 \uCC44\uC2DD'
    \uC218\uC694 \uD655\uB300"
  subheadline: "\uB3D9\uBB3C\uC131 \uC6D0\uB8CC\uB97C \uBC30\uC81C\uD55C \uBA54\uB274\uC5D0
    \uB300\uD55C \uC218\uC694\uAC00 \uAFB8\uC900\uD788 \uB298\uACE0 \uC788\uC2B5\uB2C8\uB2E4."
  body: "\uB3D9\uBB3C\uC131 \uC6D0\uB8CC\uB97C \uBC30\uC81C\uD55C \uBA54\uB274\uC5D0
    \uB300\uD55C \uC218\uC694\uAC00 \uAFB8\uC900\uD788 \uB298\uACE0 \uC788\uC2B5\uB2C8\uB2E4."
  article: "\uBE44\uAC74\uC740 \uB2E8\uC21C\uD788 \uCC44\uC2DD\uC744 \uB118\uC5B4
    \uB09C\xB7\uC6B0\uC720\xB7\uAFC0\xB7\uC824\uB77C\uD2F4 \uB4F1 \uB3D9\uBB3C \uC720\uB798
    \uC131\uBD84\uAE4C\uC9C0 \uD53C\uD558\uB294 \uC0DD\uD65C \uBC29\uC2DD\uC785\uB2C8\uB2E4.
    SNS\uC5D0\uC11C\uB294 \uBE44\uAC74 \uC778\uC99D \uB9C8\uD06C\uC640 \uB808\uC2DC\uD53C
    \uACF5\uC720\uAC00 \uD65C\uBC1C\uD558\uBA70, \uC2DD\uB2F9\uB4E4\uB3C4 \uAD50\uCC28\uC624\uC5FC
    \uBC29\uC9C0\uB97C \uAC15\uC870\uD558\uACE0 \uC788\uC2B5\uB2C8\uB2E4.\n\n\uC601\uC591\uD559\uC790\uB294
    \"\uBE44\uAC74 \uBA54\uB274\uB294 \uB2E8\uBC31\uC9C8\xB7\uBE44\uD0C0\uBBFCB12
    \uBCF4\uCDA9 \uC124\uACC4\uAC00 \uC911\uC694\uD558\uB2E4\"\uACE0 \uB367\uBD99\uC600\uC2B5\uB2C8\uB2E4.
    \uB450\uBD80\xB7\uCF69\xB7\uACAC\uACFC\uB958\uB97C \uD65C\uC6A9\uD55C \uBA54\uB274\uAC00
    \uB300\uC548\uC73C\uB85C \uB5A0\uC624\uB974\uACE0 \uC788\uC2B5\uB2C8\uB2E4."
  sidebarNote: "\uC2DD\uB2E8 \uC120\uD0DD\uC740 \uAC1C\uC778\uC758 \uC2E0\uB150\uC774\uC790
    \uAC74\uAC15 \uBB38\uC81C\uC774\uAE30\uB3C4 \uD569\uB2C8\uB2E4."
  summary: "\uC644\uC804 \uCC44\uC2DD \uC190\uB2D8\uC774 \uB298 \uC218 \uC788\uC2B5\uB2C8\uB2E4.
    \uACC4\uB780\xB7\uCE58\uC988\xB7\uB2E4\uC9C4\uACE0\uAE30 \uC131\uBD84\uC744 \uAF3C\uAF3C\uD788
    \uD655\uC778\uD558\uC138\uC694."
  illustration: {fileID: 21300000, guid: 7b00f84209dd42cdb64ff02f9fcad87f, type: 3}
  primaryStockCode: VGND
