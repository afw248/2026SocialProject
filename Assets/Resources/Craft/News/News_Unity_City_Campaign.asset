  sectionTag: "\uC0AC\uD68C"
  headline: "\uB3C4\uC2DC \uCEA0\uD398\uC778 '\uD55C \uC2DD\uD0C1\uC758 \uC774\uC6C3', \uC0C1\uC0DD \uC18C\uBE44 \uD655\uC0B0"
  subheadline: "\uD3B8\uACAC \uC5C6\uB294 \uC678\uC2DD\u00B7\uC1FC\uD551\uC744 \uB3C5\uB824\uD558\uB294 \uC2DC\uBBFC \uCEA0\uD398\uC778\uC774 \uD655\uC0B0\uB418\uACE0 \uC788\uC2B5\uB2C8\uB2E4."
  body: "\uD3B8\uACAC \uC5C6\uB294 \uC678\uC2DD\u00B7\uC1FC\uD551\uC744 \uB3C5\uB824\uD558\uB294 \uC2DC\uBBFC \uCEA0\uD398\uC778\uC774 \uD655\uC0B0\uB418\uACE0 \uC788\uC2B5\uB2C8\uB2E4."
  article: "\uC2DC\uBBFC\uB2E8\uCCB4\uC640 \uC9C0\uC790\uCCB4\uAC00 \uD568\uAED8\uD558\uB294 '\uD55C \uC2DD\uD0C1\uC758 \uC774\uC6C3' \uCEA0\uD398\uC778\uC774 \uB3C4\uC2DC \uC804\uC5ED\uC73C\uB85C \uD37C\uC9C0\uACE0 \uC788\uC2B5\uB2C8\uB2E4. \uCC38\uC5EC \uB9E4\uC7A5\uC740 \uCC28\uBCC4 \uC5C6\uB294 \uC751\uB300 \uC11C\uC57D\uACFC \uB2E4\uBB38\uD654 \uBA54\uB274 \uC548\uB0B4\uB97C \uAC8C\uC2DC\uD558\uBA70, \uBC29\uBB38\uAC1D\uC5D0\uAC8C \uC2A4\uD0EC\uD504 \uD22C\uC5B4\uB97C \uC81C\uACF5\uD569\uB2C8\uB2E4.\n\n\uCD08\uAE30 \uC9D1\uACC4\uC5D0 \uB530\uB974\uBA74 \uCC38\uC5EC \uC0C1\uAD8C\uC758 \uC8FC\uB9D0 \uB9E4\uCD9C\uC774 \uC18C\uD3ED \uC0C1\uC2B9\uD588\uC73C\uBA70, \uB2E4\uBB38\uD654 \uC0C1\uC0DD \uAD00\uB828 \uC9C0\uC218\uC5D0\uB3C4 \uAE0D\uC815 \uC2E0\uD638\uAC00 \uD3EC\uCC29\uB410\uC2B5\uB2C8\uB2E4."
  sidebarNote: "\uCEA0\uD398\uC778\uC740 \uAD6C\uD638\uAC00 \uC544\uB2C8\uB77C \uC190\uB2D8 \uD55C \uBA85\uC744 \uB300\uD558\uB294 \uD0DC\uB3C4\uC5D0\uC11C \uC2DC\uC791\uB429\uB2C8\uB2E4."
  summary: "\uB2E4\uC591\uD55C \uC190\uB2D8\uC774 \uD568\uAED8 \uCC3E\uC544\uC62C \uC218 \uC788\uB294 \uB0A0\uC785\uB2C8\uB2E4. \uC815\uD655\uD55C \uC8FC\uBB38\uC774 \uC2E0\uB8B0\uB97C \uC313\uC2B5\uB2C8\uB2E4."
  illustration: {fileID: 21300000, guid: 2ddadd6b853b4c9db95049085db4d1a3, type: 3}
  primaryStockCode: UNITY
