  headline: "\uBB3C\uAC00 \uC0C1\uC2B9"
  body: "\uD55C\uC2DD \uC7AC\uB8CC \uAC00\uACA9\uC774 \uC18C\uD3ED \uD558\uB77D\uD588\uC2B5\uB2C8\uB2E4."
  article: "\uB18D\uC0B0\uBB3C \uB3C4\uB9E4 \uC2DC\uC7A5\uC5D0\uC11C \uBC30\uCD94\uB7EC \uAC00\uACA9\uC774 \uC548\uC815\uC138\uB97C
    \uBCF4\uC774\uACE0 \uC788\uC2B5\uB2C8\uB2E4. \uD55C\uC2DD \uC5C5\uCCB4\uB294 \uC6D0\uAC00 \uBD80\uB2F4\uC774 \uC904\uC5C8\uB2E4\uBA70
    \uC22B\uD1B5\uC744 \uD2B8\uC600\uC2B5\uB2C8\uB2E4."
  summary: "\uD55C\uC2DD \uBA54\uB274 \uC218\uC694\uB294 \uD68C\uBCF5\uB420 \uC218 \uC788\uC9C0\uB9CC,
    \uAC00\uACA9\uC5D0 \uBBFC\uAC10\uD55C \uC190\uB2D8\uC774 \uB9CE\uC544\uC9C8 \uC218 \uC788\uC2B5\uB2C8\uB2E4."
