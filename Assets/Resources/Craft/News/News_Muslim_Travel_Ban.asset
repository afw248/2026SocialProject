  sectionTag: "\uAD6D\uC81C"
  headline: "\uC785\uAD6D \uC2EC\uC0AC \uAC15\uD654 \uB17C\uB780, \uD560\uB784 \uC0C1\uAD8C\uB3C4
    \uAE34\uC7A5"
  subheadline: "\uC5EC\uD589\xB7\uCCB4\uB958 \uADDC\uC81C\uAC00 \uAC15\uD654\uB418\uBA70
    \uBB34\uC2AC\uB9BC \uBC29\uBB38\uAC1D\xB7\uC0C1\uAD8C\uC774 \uC6C0\uCE20\uB7EC\uB4E4\uACE0
    \uC788\uC2B5\uB2C8\uB2E4."
  body: "\uC5EC\uD589\xB7\uCCB4\uB958 \uADDC\uC81C\uAC00 \uAC15\uD654\uB418\uBA70
    \uBB34\uC2AC\uB9BC \uBC29\uBB38\uAC1D\xB7\uC0C1\uAD8C\uC774 \uC6C0\uCE20\uB7EC\uB4E4\uACE0
    \uC788\uC2B5\uB2C8\uB2E4."
  article: "\uC77C\uBD80 \uAD6D\uAC00\uC758 \uC785\uAD6D\xB7\uCCB4\uB958 \uC2EC\uC0AC
    \uAC15\uD654 \uC18C\uC2DD\uC774 \uC804\uD574\uC9C0\uBA70 \uD604\uC9C0 \uBB34\uC2AC\uB9BC
    \uCEE4\uBBA4\uB2C8\uD2F0\uC640 \uD560\uB784 \uC678\uC2DD\uC5C5\uACC4\uAC00 \uAE34\uC7A5\uD558\uACE0
    \uC788\uC2B5\uB2C8\uB2E4. \uAD00\uAD11\xB7\uC720\uD559 \uC218\uC694\uAC00 \uC904\uC5B4\uB4E4\uBA74
    \uD560\uB784 \uC2DD\uB2F9\xB7\uC2DD\uC7AC\uB8CC \uC720\uD1B5\uB3C4 \uD0C0\uACA9\uC744
    \uBC1B\uC744 \uC218 \uC788\uB2E4\uB294 \uC804\uB9DD\uC774 \uB098\uC635\uB2C8\uB2E4.\n\n\uC2DC\uBBFC\uB2E8\uCCB4\uB294
    \"\uC815\uCC45\uACFC \uBB34\uAD00\uD55C \uC774\uC6C3\uAE4C\uC9C0 \uD3B8\uACAC\uC73C\uB85C
    \uBB36\uC5B4\uC120 \uC548 \uB41C\uB2E4\"\uACE0 \uACBD\uACE0\uD588\uC2B5\uB2C8\uB2E4.
    \uC0C1\uC778\uB4E4\uC740 \uB2E8\uACE8 \uC190\uB2D8\uACFC\uC758 \uC2E0\uB8B0\uB97C
    \uC9C0\uD0A4\uBA70 \uCC28\uBD84\uD788 \uC601\uC5C5\uD558\uACA0\uB2E4\uACE0 \uBC1D\uD614\uC2B5\uB2C8\uB2E4."
  sidebarNote: "\uC815\uCC45 \uC774\uC288\uAC00 \uC2DD\uD0C1\uC758 \uD3B8\uACAC\uC73C\uB85C
    \uBC88\uC9C0\uC9C0 \uC54A\uB3C4\uB85D \uC8FC\uC758\uAC00 \uD544\uC694\uD569\uB2C8\uB2E4."
  summary: "\uBB34\uC2AC\uB9BC \uC190\uB2D8 \uBC29\uBB38\uC774 \uC904 \uC218 \uC788\uC2B5\uB2C8\uB2E4.
    \uC7AC\uB8CC \uC548\uB0B4\uB97C \uB354 \uBD84\uBA85\uD788 \uD558\uBA74 \uB3C4\uC6C0\uC774
    \uB429\uB2C8\uB2E4."
  illustration: {fileID: 21300000, guid: be5cb8cdcdad4b62bbc39d8355f289c1, type: 3}
  primaryStockCode: HLAL
