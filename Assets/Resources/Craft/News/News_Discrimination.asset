  m_Script: {fileID: 11500000, guid: 93f2766bd19c85d478e43b4e1b5aafc5, type: 3}
  m_Name: News_Discrimination
  m_EditorClassIdentifier: Assembly-CSharp::ChangJun.Data.NewsSO
  cultureGroup: 6
