  sectionTag: "\uC724\uB9AC"
  headline: "\uACF5\uC815\uBB34\uC5ED \uB450\uBD80\xB7\uCF69\uB098\uBB3C, MZ\uC138\uB300
    \uC120\uD0DD"
  subheadline: "\uACF5\uC815\uBB34\uC5ED \uD45C\uC2DC \uC7AC\uB8CC\uB97C \uC4F0\uB294
    \uBA54\uB274\uAC00 '\uC724\uB9AC\uC801 \uC18C\uBE44' \uB300\uD45C \uC0AC\uB840\uB85C
    \uC18C\uAC1C\uB410\uC2B5\uB2C8\uB2E4."
  body: "\uACF5\uC815\uBB34\uC5ED \uD45C\uC2DC \uC7AC\uB8CC\uB97C \uC4F0\uB294 \uBA54\uB274\uAC00
    '\uC724\uB9AC\uC801 \uC18C\uBE44' \uB300\uD45C \uC0AC\uB840\uB85C \uC18C\uAC1C\uB410\uC2B5\uB2C8\uB2E4."
  article: "\uACF5\uC815\uBB34\uC5ED \uB450\uBD80\xB7\uCF69\uB098\uBB3C\uC744 \uC0AC\uC6A9\uD558\uB294
    \uC2DD\uB2F9\uC774 SNS\uC5D0\uC11C \uC8FC\uBAA9\uBC1B\uACE0 \uC788\uC2B5\uB2C8\uB2E4.
    \uC18C\uBE44\uC790\uB4E4\uC740 \"\uAC12\uC774 \uC870\uAE08 \uB354 \uB4E4\uC5B4\uB3C4
    \uC0DD\uC0B0\uC790\uC758 \uB178\uB3D9\uC744 \uC874\uC911\uD558\uACE0 \uC2F6\uB2E4\"\uACE0
    \uB2F5\uD588\uC2B5\uB2C8\uB2E4.\n\nNGO\uB294 \"\uC724\uB9AC\uC801 \uC7AC\uB8CC\uB294
    \uD504\uB9AC\uBBF8\uC5C4 \uD301\uC73C\uB85C\uB3C4 \uC774\uC5B4\uC9C8 \uC218 \uC788\uB2E4\"\uACE0
    \uC124\uBA85\uD588\uC2B5\uB2C8\uB2E4."
  sidebarNote: "\uACF5\uC815\uBB34\uC5ED\uC740 \uBA40\uB9AC \uC788\uB294 \uB18D\uBD80\uC640\uC758
    \uC5F0\uACB0\uC785\uB2C8\uB2E4."
  summary: "\uACF5\uC815\uBB34\uC5ED \uC7AC\uB8CC \uBA54\uB274\uC5D0 \uD504\uB9AC\uBBF8\uC5C4\uC774
    \uBD99\uC744 \uC218 \uC788\uC2B5\uB2C8\uB2E4."
  illustration: {fileID: 0}
  primaryStockCode: VGND
