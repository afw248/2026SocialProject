  sectionTag: "\uAD50\uC721"
  headline: "\uD560\uB784 \uD0A4\uCE5C \uAD50\uC2E4, \uC2DD\uB2F9 \uC0AC\uC7A5\uB2D8\uB3C4
    \uC218\uAC15"
  subheadline: "\uAD50\uCC28\uC624\uC5FC \uBC29\uC9C0\xB7\uC7AC\uB8CC \uAD6C\uBD84\uC744
    \uBC30\uC6B0\uB294 \uC2E4\uC2B5 \uAD50\uC721\uC774 \uC778\uAE30\uC785\uB2C8\uB2E4."
  body: "\uAD50\uCC28\uC624\uC5FC \uBC29\uC9C0\xB7\uC7AC\uB8CC \uAD6C\uBD84\uC744
    \uBC30\uC6B0\uB294 \uC2E4\uC2B5 \uAD50\uC721\uC774 \uC778\uAE30\uC785\uB2C8\uB2E4."
  article: "\uC9C0\uC790\uCCB4\uC640 \uC774\uC2AC\uB78C \uBB38\uD654\uC13C\uD130\uAC00
    \uD568\uAED8\uD558\uB294 '\uD560\uB784 \uD0A4\uCE5C' \uAD50\uC2E4\uC5D0 \uC2DD\uB2F9
    \uC6B4\uC601\uC790\uC640 \uC870\uB9AC \uC804\uACF5 \uD559\uC0DD\uC774 \uBAB0\uB9AC\uACE0
    \uC788\uC2B5\uB2C8\uB2E4. \uB3FC\uC9C0\uACE0\uAE30\xB7\uC54C\uCF54\uC62C \uBBF8\uC0AC\uC6A9\uBFD0
    \uC544\uB2C8\uB77C \uB3C4\uB9C8\xB7\uCE7C \uBD84\uB9AC, \uBCF4\uAD00 \uAD6C\uC5ED
    \uD45C\uC2DC\uAE4C\uC9C0 \uC2E4\uC2B5\uD569\uB2C8\uB2E4.\n\n\uC218\uAC15\uC0DD\uB4E4\uC740
    \"\uC190\uB2D8\uC758 \uBBFF\uC74C\uC744 \uC9C0\uD0A4\uB294 \uAE30\uC220\"\uC774\uB77C\uACE0
    \uD3C9\uAC00\uD588\uC2B5\uB2C8\uB2E4. \uD560\uB784 \uC678\uC2DD \uC778\uC99D\uC744
    \uC900\uBE44\uD558\uB294 \uB9E4\uC7A5\uB3C4 \uB298\uC5B4\uB098\uB294 \uCD94\uC138\uC785\uB2C8\uB2E4."
  sidebarNote: "\uC774\uD574\uB294 \uC548\uB0B4\uBB38\uBCF4\uB2E4 \uC8FC\uBC29\uC758
    \uC2B5\uAD00\uC5D0\uC11C \uC644\uC131\uB429\uB2C8\uB2E4."
  summary: "\uD560\uB784\xB7\uBB34\uC2AC\uB9BC \uCE5C\uD654 \uBA54\uB274\uC5D0 \uAD00\uC2EC\uC774
    \uBAB0\uB9B4 \uC218 \uC788\uC2B5\uB2C8\uB2E4."
  illustration: {fileID: 21300000, guid: 120a190741bc4610af7864f88da8305f, type: 3}
  primaryStockCode: HLAL
